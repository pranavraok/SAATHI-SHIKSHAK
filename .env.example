# ─────────────────────────────────────────────────────────────────────────────
# SAATHI-SHIKSHAK — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── FRONTEND (Vite) ──────────────────────────────────────────────────────────
# URL of your OTP backend server (local or deployed)
# Local dev:      http://localhost:3000
# Vercel deploy:  https://your-backend.vercel.app
VITE_OTP_API_BASE=http://localhost:3000

# ── BACKEND (src/server/otpServer.ts) ────────────────────────────────────────
# Get this from: https://www.fast2sms.com → Dashboard → Dev API
# KEEP THIS SECRET — never expose to frontend
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# Optional: Port for the backend server (default 3000)
# PORT=3000
